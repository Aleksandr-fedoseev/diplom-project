# Скопируйте в .env и замените значения. Файл .env в git не попадает.
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-at-least-32-characters-long-secret
# Ключи S3-хранилища (SeaweedFS). Имена MINIO_* исторические — так их читает бэкенд.
MINIO_ACCESS_KEY=heritage
MINIO_SECRET_KEY=change-me-minio-secret

# Первый администратор, создаётся при старте
ADMIN_EMAIL=admin@heritage.test
ADMIN_PASSWORD=change-me-admin

# Публичный OSRM для разработки; свой контейнер — http://osrm:5000
OSRM_URL=https://routing.openstreetmap.de/routed-foot
CORS_ORIGINS=http://localhost:3000

# Адрес сайта для ссылок в письмах.
PUBLIC_URL=http://localhost:3000

# Почта (необязательно). Без SMTP_HOST письма пишутся в лог бэкенда.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.ru

# ЮKassa (необязательно). Тестовый магазин: https://yookassa.ru/developers
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/shop/orders
