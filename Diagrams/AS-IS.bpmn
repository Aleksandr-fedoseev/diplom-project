      <bpmndi:BPMNEdge id="M_A1_s_di" bpmnElement="M_A1_s"><di:waypoint x="690" y="100" /><di:waypoint x="690" y="282" /><bpmndi:BPMNLabel><dc:Bounds x="600" y="150" width="80" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
