<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_Process_AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_Process_AsIs">
    <bpmn:participant id="P_Tourist" name="Турист" processRef="Process_AsIs" />
    <bpmn:participant id="P_Social" name="Соцсети, блоги, форумы" />
    <bpmn:participant id="P_Search" name="Поисковики, блоги, Википедия" />
    <bpmn:participant id="P_PastVu" name="PastVu, группы в соцсетях" />
    <bpmn:participant id="P_Maps" name="Яндекс.Карты / 2ГИС" />
    <bpmn:participant id="P_Guide" name="Экскурсовод / турфирма" />
    <bpmn:messageFlow id="M_C2" name="Пост без проверки" sourceRef="C2" targetRef="P_Social" />
    <bpmn:messageFlow id="M_A1_s" name="Статьи без проверки" sourceRef="P_Search" targetRef="A1" />
    <bpmn:messageFlow id="M_A1_p" name="Фото без описания" sourceRef="P_PastVu" targetRef="A1" />
    <bpmn:messageFlow id="M_A3" name="Только современная карта" sourceRef="P_Maps" targetRef="A3" />
    <bpmn:messageFlow id="M_B1" name="Программы экскурсий" sourceRef="P_Guide" targetRef="B1" />
    <bpmn:messageFlow id="M_B2" name="Расписание, цена" sourceRef="P_Guide" targetRef="B2" />
    <bpmn:messageFlow id="M_B3" name="Рассказ гида (только во время экскурсии)" sourceRef="P_Guide" targetRef="B3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" name="AS-IS: знакомство туриста с объектом наследия" isExecutable="false">
    <bpmn:startEvent id="Start" name="Возник интерес к объекту">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_choose" name="Выбрать способ знакомства с объектом">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="G_or" name="Способ?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="A1" name="Найти описание и старые фотографии объекта">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A3" name="Найти местоположение объекта на карте">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_map" name="Объект есть на карте?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A4" name="Определить место по старому адресу вручную">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A6" name="Составить маршрут вручную">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B1" name="Найти экскурсионную программу">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B2" name="Связаться с гидом и забронировать">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_exc" name="Есть экскурсия на удобное время?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_exc" name="Экскурсия недоступна">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="B3" name="Пройти экскурсию по маршруту гида">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="G_or_j" name="">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="C1" name="Посетить объекты">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_share" name="Хочет поделиться своими знаниями?">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_end" name="Объекты посещены">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="C2" name="Опубликовать свои сведения в соцсети или блоге">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_post" name="Сведения опубликованы без проверки">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_choose" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_choose" targetRef="G_or" />
    <bpmn:sequenceFlow id="F3" name="Без гида" sourceRef="G_or" targetRef="A1" />
    <bpmn:sequenceFlow id="F5" sourceRef="A1" targetRef="A3" />
    <bpmn:sequenceFlow id="F6" sourceRef="A3" targetRef="G_map" />
    <bpmn:sequenceFlow id="F8" name="Нет" sourceRef="G_map" targetRef="A4" />
    <bpmn:sequenceFlow id="F10" sourceRef="A4" targetRef="A6" />
    <bpmn:sequenceFlow id="F7" name="Да (объект существует)" sourceRef="G_map" targetRef="A6" />
    <bpmn:sequenceFlow id="F12" sourceRef="A6" targetRef="G_or_j" />
    <bpmn:sequenceFlow id="F13" name="С экскурсией" sourceRef="G_or" targetRef="B1" />
    <bpmn:sequenceFlow id="F14" sourceRef="B1" targetRef="B2" />
    <bpmn:sequenceFlow id="F15" sourceRef="B2" targetRef="G_exc" />
    <bpmn:sequenceFlow id="F16" name="Да" sourceRef="G_exc" targetRef="B3" />
    <bpmn:sequenceFlow id="F17" name="Нет" sourceRef="G_exc" targetRef="E_exc" />
    <bpmn:sequenceFlow id="F18" sourceRef="B3" targetRef="G_or_j" />
    <bpmn:sequenceFlow id="F19" sourceRef="G_or_j" targetRef="C1" />
    <bpmn:sequenceFlow id="F20" sourceRef="C1" targetRef="G_share" />
    <bpmn:sequenceFlow id="F21" name="Нет" sourceRef="G_share" targetRef="E_end" />
    <bpmn:sequenceFlow id="F22" name="Да" sourceRef="G_share" targetRef="C2" />
    <bpmn:sequenceFlow id="F23" sourceRef="C2" targetRef="E_post" />
    <bpmn:textAnnotation id="N_P1"><bpmn:text>П1. Разрозненность: описание, фото и карта — в разных сервисах, в каждом объект приходится искать отдельно</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_P2"><bpmn:text>П2. Утраченного объекта нет на карте — место определяется вручную по старому адресу</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_P3"><bpmn:text>П3. Зависимость от гида: расписание, цена, фиксированный маршрут; аудиоконтент только во время экскурсии</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_P4"><bpmn:text>П4. Сведения не верифицированы: любой может опубликовать что угодно, а потом эти записи находят другие туристы</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_N_P1" associationDirection="None" sourceRef="N_P1" targetRef="A1" />
    <bpmn:association id="As_N_P2" associationDirection="None" sourceRef="N_P2" targetRef="A4" />
    <bpmn:association id="As_N_P3" associationDirection="None" sourceRef="N_P3" targetRef="B3" />
    <bpmn:association id="As_N_P4" associationDirection="None" sourceRef="N_P4" targetRef="C2" />
    <bpmn:group id="Grp_P1" categoryValueRef="CV_Grp_P1" />
  </bpmn:process>
  <bpmn:category id="Cat_Grp_P1"><bpmn:categoryValue id="CV_Grp_P1" value="П1" /></bpmn:category>
  <bpmndi:BPMNDiagram id="Dia_Process_AsIs">
    <bpmndi:BPMNPlane id="Plane_Process_AsIs" bpmnElement="Collab_Process_AsIs">
