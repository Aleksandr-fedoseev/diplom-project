ое фото" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1490" y="470" width="220" height="56" as="geometry"/></mxCell><mxCell id="model" value="3D-реконструкция" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1490" y="550" width="220" height="56" as="geometry"/></mxCell><mxCell id="audio" value="Аудиогид" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1490" y="630" width="220" height="56" as="geometry"/></mxCell><mxCell id="doc" value="Архивный документ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1490" y="710" width="220" height="56" as="geometry"/></mxCell><mxCell id="src" value="Источник сведений&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;i&gt;архив, публикация, свидетельство жителя&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="800" width="220" height="56" as="geometry"/></mxCell><mxCell id="bld" value="Здание или сооружение" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="680" width="220" height="56" as="geometry"/></mxCell><mxCell id="monument" value="Памятник, монумент" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" paren