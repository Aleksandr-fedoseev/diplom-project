<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_Process_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_Process_ToBe">
    <bpmn:participant id="P_Platform" name="Веб-платформа исторического наследия Астраханской области" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" name="TO-BE: знакомство с объектом наследия через веб-платформу" isExecutable="false">
    <bpmn:laneSet id="LS_Process_ToBe">
      <bpmn:lane id="L_Tourist" name="Турист (гость)">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Author" name="Автор материала">
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Platform" name="Веб-платформа (система)">
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Moder" name="Модератор / эксперт АНО">
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Возник интерес к объекту">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Открыть веб-платформу">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P1" name="Показать объекты на интерактивной карте, включая утраченные">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Способ знакомства?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Выбрать готовый тематический маршрут">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Выбрать объекты на карте (поиск, фильтры)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P2" name="Построить маршрут и сформировать карточки объектов">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DA1"><bpmn:sourceRef>DS</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T4" name="Изучить карточку: история, архивные фото, 3D-просмотр">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Пройти маршрут с аудиогидом">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Хочет поделиться своим объектом?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Объекты посещены">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="A1" name="Заполнить заявку: место, дата, источник, фото">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P3" name="Зарегистрировать заявку (статус «На модерации»)">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA2"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="M1" name="Проверить достоверность, источник и дубликаты">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="Решение по заявке?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P4" name="Опубликовать объект на карте">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA3"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="M2" name="Указать причину отказа">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P6" name="Уведомить автора о решении">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3" name="Автор получил решение">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="P1" />
    <bpmn:sequenceFlow id="F3" sourceRef="P1" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="Готовый" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F5" name="Свой" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" sourceRef="G2" targetRef="P2" />
    <bpmn:sequenceFlow id="F9" sourceRef="P2" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="G3" />
    <bpmn:sequenceFlow id="F12" name="Нет" sourceRef="G3" targetRef="E1" />
    <bpmn:sequenceFlow id="F13" name="Да" sourceRef="G3" targetRef="A1" />
    <bpmn:sequenceFlow id="F14" sourceRef="A1" targetRef="P3" />
    <bpmn:sequenceFlow id="F15" sourceRef="P3" targetRef="M1" />
    <bpmn:sequenceFlow id="F16" sourceRef="M1" targetRef="G4" />
    <bpmn:sequenceFlow id="F17" name="Одобрить" sourceRef="G4" targetRef="P4" />
    <bpmn:sequenceFlow id="F18" name="Отклонить" sourceRef="G4" targetRef="M2" />
    <bpmn:sequenceFlow id="F19" sourceRef="P4" targetRef="P6" />
    <bpmn:sequenceFlow id="F20" sourceRef="M2" targetRef="P6" />
    <bpmn:sequenceFlow id="F22" sourceRef="P6" targetRef="E3" />
    <bpmn:dataStoreReference id="DS" name="Единый реестр объектов наследия" dataStoreRef="Store_DS" />
    <bpmn:textAnnotation id="R1"><bpmn:text>Р1 (→П1). Единая карточка объекта: история, архивные фото, аудиогид, 3D-просмотр — в одном месте</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="R2"><bpmn:text>Р2 (→П2). Утраченные объекты отмечены на карте по исходному адресу</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="R4"><bpmn:text>Р3 (→П3). Маршрут и аудиогид доступны без гида в любое время</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="R5"><bpmn:text>Р4 (→П1, П4). Материалы проходят экспертную проверку и только после этого попадают в единую базу и на карту</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_R1" associationDirection="None" sourceRef="R1" targetRef="P2" />
    <bpmn:association id="As_R2" associationDirection="None" sourceRef="R2" targetRef="P1" />
    <bpmn:association id="As_R4" associationDirection="None" sourceRef="R4" targetRef="T5" />
    <bpmn:association id="As_R5" associationDirection="None" sourceRef="R5" targetRef="M1" />
  </bpmn:process>
  <bpmn:dataStore id="Store_DS" name="Единый реестр объектов наследия" />
  <bpmndi:BPMNDiagram id="Dia_Process_ToBe">
